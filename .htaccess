# ════════════════════════════════════════════════════════════
# .htaccess — mueblesamedidaenvitoria.com.es · Producción (Apache 2.4)
# Estructura del sitio: carpetas con index.html → URLs con barra final (/armarios-a-medida/)
# ════════════════════════════════════════════════════════════

Options -Indexes
DirectoryIndex index.html
DirectorySlash On
RewriteEngine On

# ── 1. HOST CANÓNICO: https + sin www (una sola redirección) ─
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ── 2. REDIRECCIONES 301 — URLs antiguas ─────────────────────
RewriteRule ^armarios-empotrados-a-medida/?$ /armarios-a-medida/empotrados/ [R=301,L]
RewriteRule ^vestidores-a-medida/?$ /armarios-a-medida/vestidores/ [R=301,L]

# ── 3. /carpeta/index.html y /index.html → /carpeta/ ─────────
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ── 4. /pagina.html → /pagina/ (si existe la carpeta) ────────
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
RewriteRule ^ /%1/ [R=301,L]

# ── 5. COMPRESIÓN ─────────────────────────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml application/xml text/xml application/manifest+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml application/manifest+json
</IfModule>

# ── 6. TIPOS MIME ─────────────────────────────────────────────
AddType application/manifest+json .webmanifest
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2

# ── 7. CACHÉ ──────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 1 hour"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# ── 8. CABECERAS DE SEGURIDAD ─────────────────────────────────
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  # CSS/JS llevan ?v=hash en la URL → caché inmutable segura
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Páginas de error y agradecimiento: nunca en el índice
  <FilesMatch "^404\.html$">
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
</IfModule>

# ── 9. BLOQUEAR ARCHIVOS SENSIBLES (sintaxis Apache 2.4) ─────
<FilesMatch "(^\.|\.(md|py|json|ini|log|zip|bak|sql|lock)$|^mail-config.*\.php$|^composer\.)">
  Require all denied
</FilesMatch>
<FilesMatch "^manifest\.webmanifest$">
  Require all granted
</FilesMatch>
RedirectMatch 404 ^/(tools|partials|lib|dist)(/.*)?$

# ── 10. PÁGINAS DE ERROR ──────────────────────────────────────
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
